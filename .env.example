# MACHINE_BOOT_RETRY_COUNT=1
# MOVE_TURN_GRACE_SECONDS=120
# MOVE_WAKE_TIMEOUT_SECONDS=300
# When a status stops saying work is happening: a running turn whose worker
# has not renewed its stamp, a sent message a machine that answers has not
# started on, and a held workspace folder whose box has stopped beating.
# CHAT_TURN_SILENCE_SECONDS=120
# CHAT_TURN_START_SECONDS=180
# FILES_SYNC_PAUSE_SECONDS=60
# When the server ends a running turn whose worker went quiet, and puts back to
