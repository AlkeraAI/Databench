        {
          "op": "edit",
          "cell_id": "a1b2c3d4e5",
          "edits": [
            {
              "old": "a",
              "new": "b",
              "occurrence": 2
            }
          ]
        }
      ],
      "expect": {
        "cells": [
          [
            "a1b2c3d4e5",
            "python",
            "a\nb"
          ]
        ]
      }
    },
