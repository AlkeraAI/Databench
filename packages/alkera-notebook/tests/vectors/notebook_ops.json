{
  "description": "Notebook ops and what every applier (the file store, the platform's live document, the browser editor) must make of them. `cells` are the live cells before; `expect` is either the live cells after as [id, kind, source] or the refusal as {error, index}. Rules: alkera_notebook.format.op_rules.",
  "cases": [
    {
      "name": "edit_replaces_the_one_match",
      "cells": [
        {
          "id": "a1b2c3d4e5",
          "kind": "python",
          "source": "x = 1\ny = 2"
        }
      ],
      "ops": [
        {
          "op": "edit",
          "cell_id": "a1b2c3d4e5",
          "edits": [
            {
              "old": "y = 2",
              "new": "y = 3"
            }
          ]
        }
      ],
      "expect": {
        "cells": [
          [
            "a1b2c3d4e5",
            "python",
            "x = 1\ny = 3"
          ]
        ]
      }
    },
    {
      "name": "edit_refuses_an_ambiguous_match",
      "cells": [
        {
          "id": "a1b2c3d4e5",
          "kind": "python",
          "source": "a\na"
        }
      ],
      "ops": [
        {
          "op": "edit",
          "cell_id": "a1b2c3d4e5",
          "edits": [
            {
              "old": "a",
              "new": "b"
            }
          ]
        }
      ],
      "expect": {
        "error": "edit_ambiguous",
        "index": 0
      }
    },
    {
      "name": "edit_picks_an_occurrence",
      "cells": [
        {
          "id": "a1b2c3d4e5",
          "kind": "python",
          "source": "a\na"
        }
