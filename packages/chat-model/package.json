{
  "name": "@alkera/chat-model",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "The shared conversation model: the generated tool manifest and schemas, the conversation types and the permission presentation every chat surface renders. React-free: UI libraries depend on this package, never the reverse.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./permission-vectors": "./src/generated/permissionPresentationVectors.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen-tool-schemas": "node scripts/gen-tool-schemas.mjs",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@alkera/eslint-config": "workspace:*",
    "eslint": "^9.10.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "^5.5.4",
    "vitest": "4.1.11"
  }
}
