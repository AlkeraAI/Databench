{% extends "base.mjml" %}
{% from "_macros.mjml" import cta %}
{% block title %}Reset your {{ product_name }} password{% endblock %}
{% block preview %}Choose a new password for your {{ product_name }} account.{% endblock %}
{% block content %}
<mj-text font-family="{{ tokens.FONT_DISPLAY }}" font-size="18px" font-weight="600" padding-bottom="8px">
  {% if name %}Hi {{ name }},{% else %}Reset your password{% endif %}
</mj-text>
<mj-text>
  Someone requested a password reset for your {{ product_name }} account. Choose a new password using the button below.
</mj-text>
{{ cta(reset_url, "Reset password") }}
<mj-text font-size="13px" color="{{ tokens.MUTED }}" padding-top="8px">
  This link expires in 1 hour. If you didn't request a reset, you can ignore this email — your password won't change.
</mj-text>
{% endblock %}
