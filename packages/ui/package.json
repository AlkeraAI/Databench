{
  "name": "@alkera/ui",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "The Databench UI library: base components and the shared token layer for the web portal.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./storage": "./src/storage.ts",
    "./backoff": "./src/backoff.ts",
    "./connections": "./src/connections/index.ts",
    "./lineage": "./src/lineage/index.ts",
    "./graph": "./src/graph/index.ts",
    "./extensions": "./src/extensions.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/styles": "./src/auth/styles.css",
    "./styles": "./src/theme/styles.css",
    "./fonts": "./src/theme/fonts.css",
    "./chat/styles": "./src/chat/theme/styles.css",
    "./chat/fonts": "./src/chat/theme/fonts.css",
    "./chat/tool-tokens": "./src/chat/tools/tokens.css",
    "./package.json": "./package.json",
    "./eslint.config.js": "./eslint.config.js",
    "./tsconfig.json": "./tsconfig.json",
    "./svgr": "./svgr.config.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "build:charts-frame": "vite build --config vite.charts-frame.config.ts && node scripts/checkChartsBundle.mjs dist/alkera-charts.iife.js"
  },
  "dependencies": {
    "@alkera/chart-guard": "workspace:*",
    "@alkera/chat-model": "workspace:*",
    "@floating-ui/react": "^0.27.19",
    "@fontsource/hanken-grotesk": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.2.10",
    "@tabler/icons-react": "^3.44.0",
    "clsx": "^2.1.1",
    "katex": "^0.18.2",
    "prismjs": "^1.30.0",
    "vega": "^6.2.0",
    "vega-interpreter": "^2.2.0",
    "vega-lite": "^6.4.0"
  },
  "peerDependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@alkera/eslint-config": "workspace:*",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.10",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.10.0",
    "jsdom": "25.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "4.1.11"
  }
}
