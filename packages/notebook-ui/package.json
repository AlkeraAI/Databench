    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.14.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.10.0",
    "jsdom": "25.0.0",
    "react": "19.2.5",
