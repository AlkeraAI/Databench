{
  "name": "@alkera/web",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./vite-config": "./webConfig.ts",
    "./source-overlay": "./src/vite/sourceOverlay.ts",
    "./package.json": "./package.json",
    "./eslint.config.js": "./eslint.config.js",
    "./tsconfig.json": "./tsconfig.json"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner && node scripts/checkBundle.mjs dist",
    "build:vscode": "tsc --noEmit && vite build --configLoader runner --mode vscode && node scripts/checkBundle.mjs dist-vscode",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "e2e": "playwright test",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alkera/chat-model": "workspace:*",
    "@alkera/notebook-ui": "workspace:*",
    "@alkera/sdk": "workspace:*",
    "@alkera/ui": "workspace:*",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@marsidev/react-turnstile": "^1.5.3",
    "@sentry/react": "^10.64.0",
    "@tabler/icons-react": "^3.43.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@xyflow/react": "^12.10.2",
    "loro-crdt": "1.16.4",
    "prismjs": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@alkera/eslint-config": "workspace:*",
    "@alkera/widgets": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.10",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.10.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  }
}
