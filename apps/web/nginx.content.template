# The Files content origin, rendered by `docker-entrypoint.sh` only when
# FILES_CONTENT_BASE_URL names one. Uploaded bytes are served from their own
# hostname, never the app's, and the backend serves them under /c. This server
# answers only that hostname and only /c: the app's own paths stay on the app's
# origin, where the session cookie lives. The variables substituted are
# `${ALKERA_BACKEND_URL}` and `${ALKERA_CONTENT_HOST}`.
server {
    listen      8080;
    listen      [::]:8080;
    server_name ${ALKERA_CONTENT_HOST};

    access_log /var/log/nginx/access.log alkera_access;

    location /c/ {
        proxy_pass         ${ALKERA_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # A file streams both ways: a download as it is read from the store, an
        # upload (the content PUT, 64 MiB at most) as it arrives.
        proxy_buffering         off;
        proxy_request_buffering off;
        client_max_body_size    64m;
        proxy_read_timeout      3600s;
        proxy_send_timeout      3600s;
    }

    location / {
        return 404;
    }
}
