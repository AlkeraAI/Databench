# ============================================================
# apps/web — frontend-only env vars.
#
# Vite ONLY reads env files from this directory (apps/web/). It does
# NOT read the repo-root .env — that file is for the Python apps.
#
# For local dev you can leave this file alone: the Vite dev server
# proxies /api and /health to this checkout's backend (VITE_API_PROXY_TARGET
# from the repo-root .env.workspace; http://localhost:8000 on `main`; see
# vite.config.ts), so the app works without VITE_API_BASE_URL being set.
#
# To point the frontend at a non-local API, copy this file to
# .env.local and set VITE_API_BASE_URL.
#
# Only variables prefixed with VITE_ are exposed to client code.
# ============================================================

# Leave EMPTY for local dev — Vite's proxy forwards same-origin requests
# (`/api`, `/health`) to the FastAPI backend. Setting this to
# `http://localhost:8000` bypasses the proxy and triggers cross-origin
# cookie issues unless the backend's CORS allow_origins lists your SPA's
# origin (it does for :5173, but you'll fight CORS preflight on every request).
#
# Override ONLY when pointing at a non-local API.
# Example: VITE_API_BASE_URL=https://api.alkera.example
VITE_API_BASE_URL=

# Sentry DSN for a product build that registers the Sentry sink. The open build
# registers no telemetry and ignores it. Baked in at BUILD time (Vite inlines
# VITE_* vars). A Sentry DSN is a public ingest key, not a secret.
VITE_SENTRY_DSN=
# The build's environment tag (defaults to "production"). A production build
# requires VITE_TURNSTILE_SITE_KEY.
VITE_APP_ENV=

# Cloudflare Turnstile PUBLIC site key for the invisible captcha on the login,
# signup, and forgot-password pages. Leave EMPTY to disable the widget (local dev
# without a Cloudflare account); the auth pages then submit with no token, matching
# a backend that has no TURNSTILE_SECRET_KEY set. Baked in at BUILD time (Vite
# inlines VITE_* vars); a PRODUCTION build (VITE_APP_ENV=production) REQUIRES it —
# vite.config.ts fails the build otherwise. A site key is public, not a secret.
# For local testing, use the published invisible "always passes" dummy site key
# (pair with TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA on the API):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB
VITE_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID for a product build that registers the analytics
# sink. The open build registers no telemetry and ignores it. A measurement ID is
# public, not a secret.
VITE_GA_MEASUREMENT_ID=
